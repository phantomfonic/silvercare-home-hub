# 複製為 .env 後按需修改。未設 OPENAI_API_KEY 時 Agent 走規則引擎（零成本可跑）。

PORT=8787
HOST=0.0.0.0
# 正式環境填 Postgres；留空則用內建 PGlite（本機／演示）
DATABASE_URL=
# 資料目錄（PGlite 持久化）
DATA_DIR=./data

# 可選：OpenAI 相容 API，讓對話更自然
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Channel：web | whatsapp
CHANNEL_MODE=web

# WhatsApp Cloud API（CHANNEL_MODE=whatsapp 時需要）
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=silvercare-verify
WHATSAPP_APP_SECRET=

# CORS／前端
WEB_ORIGIN=http://localhost:5173
CENTER_NAME=銀護示範院舍・居家外展
